<?xml version="1.0" encoding="utf-8"?>
<!-- Horizon OS overlay for the quest flavor. Merged on top of src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <!-- Theater mode (R10): Meta Spatial SDK hybrid app. Entries follow Meta's HybridSample (SDK 0.15.0). -->
    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="69" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:glEsVersion="0x00030001" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <application>
        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />

        <activity
            android:name="io.github.snowcivilian.questairplay.theater.TheaterActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Documented: https://developers.meta.com/vr/documentation/android-apps/port-an-existing-app -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3" />

        <!-- Undocumented Horizon OS shell flags (seen in other Quest apps' manifests, not in Meta's
             public docs). Ask the shell to keep the panel's aspect ratio while resizing. Verify on device. -->
        <meta-data
            android:name="com.oculus.vrshell.supports_free_resizing"
            android:value="true" />
        <meta-data
            android:name="com.oculus.vrshell.free_resizing_lock_aspect_ratio"
            android:value="true" />

        <activity
            android:name="io.github.jqssun.airplay.MainActivity"
            tools:node="merge">
            <!-- Launch as a large 16:9 panel; dp units per Meta's porting guide. -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="720dp"
                android:minWidth="640dp"
                android:minHeight="360dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="16:9" />
            <!-- hybrid app: this is the 2D panel entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
        </activity>

        <!-- Per-aspect panels (R5). Horizon OS has no runtime panel resize, so PanelSwitcher relaunches into these. -->
        <activity
            android:name="io.github.snowcivilian.questairplay.panel.Panel4x3Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="720dp"
                android:minWidth="480dp"
                android:minHeight="360dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="4:3" />
        </activity>

        <activity
            android:name="io.github.snowcivilian.questairplay.panel.Panel3x2Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <layout
                android:defaultWidth="1080dp"
                android:defaultHeight="720dp"
                android:minWidth="540dp"
                android:minHeight="360dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="3:2" />
        </activity>

        <activity
            android:name="io.github.snowcivilian.questairplay.panel.Panel10x9Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <layout
                android:defaultWidth="800dp"
                android:defaultHeight="720dp"
                android:minWidth="400dp"
                android:minHeight="360dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="10:9" />
        </activity>

        <activity
            android:name="io.github.snowcivilian.questairplay.panel.Panel8x7Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <layout
                android:defaultWidth="822dp"
                android:defaultHeight="720dp"
                android:minWidth="411dp"
                android:minHeight="360dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="8:7" />
        </activity>

        <activity
            android:name="io.github.snowcivilian.questairplay.panel.Panel2x3Activity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop">
            <layout
                android:defaultWidth="600dp"
                android:defaultHeight="900dp"
                android:minWidth="300dp"
                android:minHeight="450dp" />
            <meta-data android:name="io.github.snowcivilian.questairplay.PANEL_ASPECT" android:value="2:3" />
        </activity>

        <!-- Seeds Quest-specific defaults into upstream's settings store before Application.onCreate. -->
        <provider
            android:name="io.github.snowcivilian.questairplay.QuestDefaultsProvider"
            android:authorities="${applicationId}.questdefaults"
            android:exported="false"
            android:initOrder="1000" />
    </application>
</manifest>
